 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "SCH-SMS-.YYYY.-",
   "reqd": 1
  },
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Title",
   "reqd": 1
  },
  {
   "fieldname": "message",
   "fieldtype": "Small Text",
   "label": "Message",
   "reqd": 1,
   "description": "Use {{name}} to personalize with recipient's name"
  },
  {
   "fieldname": "send_to",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Send To",
   "options": "\nAll Members\nSpecific Branch\nSpecific Members",
   "reqd": 1
  },
  {
   "fieldname": "branch",
   "fieldtype": "Link",
   "label": "Branch",
   "options": "Church Branch",
   "depends_on": "eval:doc.send_to=='Specific Branch'"
  },
  {
   "fieldname": "sender_id",
   "fieldtype": "Data",
   "label": "Sender ID",
   "default": "KKKT MABIBO"
  },
  {
   "fieldname": "schedule_section",
   "fieldtype": "Section Break",
   "label": "Schedule"
  },
  {
   "fieldname": "schedule_type",
   "fieldtype": "Select",
   "label": "Schedule Type",
   "options": "\nOnce\nDaily\nWeekly\nMonthly",
   "reqd": 1,
   "default": "Once"
  },
  {
   "fieldname": "start_date",
   "fieldtype": "Date",
   "label": "Start Date",
   "reqd": 1
  },
  {
   "fieldname": "start_time",
   "fieldtype": "Time",
   "label": "Start Time",
   "reqd": 1
  },
  {
   "fieldname": "repeat_every",
   "fieldtype": "Int",
   "label": "Repeat Every (days/weeks/months)",
   "default": 1,
   "depends_on": "eval:doc.schedule_type!='Once'"
  },
  {
   "fieldname": "repeat_days",
   "fieldtype": "Select",
   "label": "Repeat On (for Weekly)",
   "options": "\nMonday\nTuesday\nWednesday\nThursday\nFriday\nSaturday\nSunday",
   "depends_on": "eval:doc.schedule_type=='Weekly'"
  },
  {
   "fieldname": "end_date",
   "fieldtype": "Date",
   "label": "End Date (optional)"
  },
  {
   "fieldname": "status_section",
   "fieldtype": "Section Break",
   "label": "Status"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Active\nPaused\nCompleted\nCancelled",
   "default": "Active",
   "in_list_view": 1
  },
  {
   "fieldname": "last_sent",
   "fieldtype": "Datetime",
   "label": "Last Sent",
   "read_only": 1
  },
  {
   "fieldname": "next_scheduled",
   "fieldtype": "Datetime",
   "label": "Next Scheduled",
   "read_only": 1
  },
  {
   "fieldname": "times_sent",
   "fieldtype": "Int",
   "label": "Times Sent",
   "default": 0,
   "read_only": 1
  }
 ],
